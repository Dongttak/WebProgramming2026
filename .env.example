# Local development:
# - Leave VITE_API_BASE_URL empty to call /api through the Vite proxy.
# - VITE_BACKEND_URL is used only by vite.config.js during local dev.
VITE_API_BASE_URL=
VITE_BACKEND_URL=http://127.0.0.1:5050

# Vercel production:
# VITE_API_BASE_URL=https://your-render-service.onrender.com
